    def toggle_token(self):
        self.token_entry.configure(show="" if self.show_var.get() else "•")

    def show_page(self, name):
        self.navigation.set(name)
        if name == "Code Workspace":
            self.key_page.pack_forget()
            if self.editor is None:
                self.editor = CodeWorkspace(self.main)
            self.editor.pack(fill="both", expand=True)
        else:
            if self.editor is not None:
                self.editor.pack_forget()
            self.key_page.pack(fill="both", expand=True)

    def toggle_conn_strip(self):
        if self.navigation.get() != "Key Manager":
            self.show_page("Key Manager")
            if self.conn_strip_visible:
                return
        if self.conn_strip_visible:
            self.conn_strip.pack_forget()
        else:
            self.conn_strip.pack(fill="x", padx=24, pady=(16, 8),
                                 before=self.page_heading)
        self.conn_strip_visible = not self.conn_strip_visible

    def on_preset(self, label):
        self.hours_var.set(str(dict(PRESETS)[label]))

    def unsync_preset(self):
        try:
            val = int(self.hours_var.get().strip())
        except ValueError:
            val = None
        match = [l for l, h in PRESETS if h == val]
        try:
            self.preset_seg.set(match[0] if match else "")
        except Exception:
            pass

    def toast(self, text, color=GREEN_ONLINE):
        if self.toast_job:
            self.root.after_cancel(self.toast_job)
        if self.toast_frame is not None:
            self.toast_frame.destroy()
        f = ctk.CTkFrame(self.main, fg_color=CARD_SURFACE, border_color=color,
                         border_width=1, corner_radius=12)
        ctk.CTkLabel(f, text=text, font=(FONT, 12, "bold"),
                     text_color=color).pack(padx=18, pady=10)
        f.place(relx=1.0, rely=1.0, x=-28, y=-28, anchor="se")
        self.toast_frame = f
        self.toast_job = self.root.after(2200, self.hide_toast)

    def hide_toast(self):
        if self.toast_frame is not None:
            self.toast_frame.destroy()
            self.toast_frame = None
        self.toast_job = None

    def trigger(self, task, *args):
        threading.Thread(target=task, args=args, daemon=True).start()

    # ---------------------------------------------------------- actions
    def connect(self):
        url = self.url_var.get().strip()
        token = self.token_var.get().strip()
        if not url:
            return messagebox.showerror("Configuration Error", "Worker URL can't be empty.")
        self.status_lbl.configure(text="● Connecting...", text_color=AMBER_PROGRESS)
        self.connect_btn.configure(state="disabled")
        self.save_config()
        self.trigger(self._bg_connect, url, token)

    def _bg_connect(self, url, token):
        try:
            self.api.base = url
            self.api.token = token
            self.api.ping()
            self.q.put(("CONNECT_OK", self.api.list_keys()))
        except Exception as e:
            self.q.put(("CONNECT_ERR", str(e)))

    def refresh(self):
        if not self.connected:
            return
        self.status_lbl.configure(text="● Syncing...", text_color=AMBER_PROGRESS)
        self.trigger(self._bg_refresh)

    def _bg_refresh(self):
        try:
            self.q.put(("REFRESH_OK", self.api.list_keys()))
        except Exception as e:
            self.q.put(("REFRESH_ERR", str(e)))

    def generate(self):
        perm = bool(self.perm_var.get())
        try:
            count = int(self.count_var.get().strip())
            hours = 0 if perm else int(self.hours_var.get().strip())
            if count <= 0 or (not perm and hours <= 0):
                raise ValueError
        except ValueError:
            return messagebox.showerror("Invalid input", "Hours and quantity must be positive numbers.")
        if count > 50:
            count = 50
            self.count_var.set("50")
        self.status_lbl.configure(text="● Generating...", text_color=AMBER_PROGRESS)
        self.trigger(self._bg_gen, hours, count, perm)

    def _bg_gen(self, hours, count, perm):
        try:
            self.q.put(("GEN_OK", (self.api.generate(None, hours, count, perm), perm)))
        except Exception as e:
            self.q.put(("GEN_ERR", str(e)))

    def copy_text(self, text, note="Copied to clipboard"):
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self.toast("✓  " + note)

    def reset_hwid(self, key):
        if messagebox.askyesno("Reset key", "Unlock this key so another account can use it?\n\n" + key):
            self.status_lbl.configure(text="● Resetting...", text_color=AMBER_PROGRESS)
            self.trigger(self._bg_action, "RESET_OK", self.api.reset, key)

    def delete_key(self, key):
        if messagebox.askyesno("Revoke key", "Permanently revoke this key?\n\n" + key):
            self.status_lbl.configure(text="● Revoking...", text_color=AMBER_PROGRESS)
            self.trigger(self._bg_action, "DELETE_OK", self.api.revoke, key)

    def _bg_action(self, ok_tag, func, key_str):
        try:
            func(key_str)
        except Exception as e:
            self.q.put(("ACTION_ERR", str(e)))
            return
        # the action worked; a failed list afterwards must not look like a failed action
        try:
            self.q.put((ok_tag, self.api.list_keys()))
        except Exception as e:
            self.q.put((ok_tag, None))

    def pump(self):
        try:
            while True:
                msg, data = self.q.get_nowait()
                if msg == "CONNECT_OK":
                    self.connected = True
                    self.status_lbl.configure(text="● Online", text_color=GREEN_ONLINE)
                    self.update_keys(data)
                    if self.conn_strip_visible:
                        self.toggle_conn_strip()
                elif msg == "CONNECT_ERR":
                    self.connected = False
                    self.status_lbl.configure(text="● Connection failed", text_color=RED_DANGER)
                    messagebox.showerror("Connection error", data)
                elif msg in ("REFRESH_OK", "GEN_OK", "RESET_OK", "DELETE_OK"):
                    self.status_lbl.configure(text="● Online", text_color=GREEN_ONLINE)
                    if msg == "GEN_OK":
                        self.show_new_keys(*data)
                    else:
                        if data is None:
                            self.refresh()
                        else:
                            self.update_keys(data)
                        if msg == "RESET_OK":
                            self.toast("✓  Key reset")
                        elif msg == "DELETE_OK":
                            self.toast("✓  Key revoked")
                elif msg in ("REFRESH_ERR", "GEN_ERR", "ACTION_ERR"):
                    self.status_lbl.configure(text="● Error", text_color=RED_DANGER)
                    messagebox.showerror("Error", data)
                self.update_action_states()
        except queue.Empty:
            pass
        self.root.after(100, self.pump)

    def tick(self):
        now = time.time()
        if self.connected and self.auto_var.get() and (now - self.last_refresh >= AUTO_REFRESH_SECONDS):
            self.last_refresh = now
            self.refresh()
        elapsed = (now - self.fetched_at) / 3600.0 if self.fetched_at else 0.0
        for lbl, base in list(self.time_labels.values()):
            try:
                rem = base - elapsed
                lbl.configure(text=fmt_left(rem), text_color=time_color(rem))
            except Exception:
                pass
        self.root.after(1000, self.tick)

    def update_keys(self, key_list):
        self.keys = key_list
        self.fetched_at = time.time()
        self.last_refresh = time.time()
        total = len(key_list)
        used = sum(1 for k in key_list if key_used(k))
        perm = sum(1 for k in key_list if key_perm(k))
        for v, n in zip(self.stat_vals, (total, used, total - used, perm)):
            v.configure(text=str(n))
        self.render_rows()

    # ------------------------------------------------------------ rows
    def key_state(self, k, rem):
        if key_perm(k):
            return "perm"
        if rem <= 0:
            return "expired"
        return "used" if key_used(k) else "free"

    def render_rows(self):
        for w in self.scroll_list.winfo_children():
            w.destroy()
        self.time_labels = {}
        elapsed = (time.time() - self.fetched_at) / 3600.0 if self.fetched_at else 0.0

        q = self.search_entry.get().strip().lower()
        flt = self.filter_seg.get() or "All"
        rows = []
        for k in self.keys:
            if q and q not in k.get("key", "").lower():
                continue
            rem = key_hours(k) - elapsed
            if flt == "Available" and (key_used(k) or (not key_perm(k) and rem <= 0)):
                continue
            if flt == "In use" and not key_used(k):
                continue
            if flt == "Permanent" and not key_perm(k):
                continue
            rows.append((k, rem))
        # permanent first, then most time left first
        rows.sort(key=lambda r: (0 if key_perm(r[0]) else 1, -r[1]))
        self.count_lbl.configure(text="%d shown" % len(rows) if self.keys else "")

        if not rows:
            msg = ("No keys match your filter." if self.keys else
                   "No active keys yet. Generate some on the left." if self.connected
                   else "Connect to your worker to see your keys.")
            empty = ctk.CTkFrame(self.scroll_list, fg_color="transparent")
            empty.pack(fill="x", pady=58)
            ctk.CTkLabel(empty, text="◇", font=(FONT, 44),
                         text_color=ACCENT_PURPLE).pack()
            title = "No matching keys" if self.keys else "Your keys live here"
            self.label(empty, title, 19, color=TEXT_WHITE).pack(pady=(10, 6))
            ctk.CTkLabel(empty, text=msg, font=(FONT, 13), wraplength=420,
                         text_color=TEXT_MUTED).pack()
            return

        styles = {
            "perm": (PERM_LAVENDER, PILL_LAVENDER, "∞ Permanent"),
            "used": (ACCENT_PURPLE, PILL_PURPLE, "● In use"),
            "free": (GREEN_ONLINE, PILL_GREEN, "● Available"),
            "expired": (RED_DANGER, PILL_RED, "● Expired"),
        }

        for k, rem in rows:
            key_str = k.get("key", "")
            state = self.key_state(k, rem)
            color, pill_bg, pill_txt = styles[state]
            copy_cmd = lambda e=None, s=key_str: self.copy_text(s)

            row = ctk.CTkFrame(self.scroll_list, fg_color=BG_WORKSPACE, height=62,
                               corner_radius=10, border_color=BORDER_TINT, border_width=1)
            row.pack(fill="x", pady=3, padx=4)
            row.pack_propagate(False)
            inner = ctk.CTkFrame(row, fg_color="transparent")
            inner.pack(fill="both", expand=True, padx=1, pady=1)
            self.setup_cols(inner)

            bar = ctk.CTkFrame(inner, width=4, fg_color=color, corner_radius=2)
            bar.grid(row=0, column=0, sticky="ns", padx=(8, 2), pady=10)

            kl = ctk.CTkLabel(inner, text=key_str if len(key_str) <= 20 else key_str[:17] + "…",
                              width=150, font=("Consolas", 12, "bold"),
                              text_color=TEXT_WHITE, anchor="w")
            kl.grid(row=0, column=1, sticky="w", padx=(8, 4))
            kl.bind("<Button-1>", copy_cmd)

            ctk.CTkLabel(inner, text=pill_txt, font=(FONT, 11, "bold"), text_color=color,
                         fg_color=pill_bg, corner_radius=11, width=92, height=24
                         ).grid(row=0, column=2, sticky="w", padx=4)

            uid = k.get("uid") or k.get("hwid")
            ctk.CTkLabel(inner, text=(str(uid)[:9] + "…" if len(str(uid)) > 10 else str(uid)) if uid else "—",
                         width=75, font=(FONT, 11),
                         text_color=TEXT_WHITE if uid else TEXT_MUTED, anchor="w"
                         ).grid(row=0, column=3, sticky="w", padx=4)

            if state == "perm":
                ctk.CTkLabel(inner, text="Never", font=(FONT, 12, "bold"),
                             text_color=PERM_LAVENDER, anchor="w"
                             ).grid(row=0, column=4, sticky="w", padx=4)
            else:
                tl = ctk.CTkLabel(inner, text=fmt_left(rem), font=(FONT, 12, "bold"),
                                  text_color=time_color(rem), anchor="w")
                tl.grid(row=0, column=4, sticky="w", padx=4)
                self.time_labels[key_str] = (tl, key_hours(k))

            acts = ctk.CTkFrame(inner, fg_color="transparent")
            acts.grid(row=0, column=5, sticky="e", padx=(4, 12))
            ctk.CTkButton(acts, text="Copy", width=54, height=30, corner_radius=8,
                          fg_color=BORDER_TINT, hover_color="#2E2A52", font=(FONT, 11),
                          command=copy_cmd).pack(side="left", padx=2)
            ctk.CTkButton(acts, text="Reset", width=54, height=30, corner_radius=8,
                          fg_color="#25354B", hover_color="#354965", font=(FONT, 11),
                          command=lambda s=key_str: self.reset_hwid(s)).pack(side="left", padx=2)
            ctk.CTkButton(acts, text="Revoke", width=60, height=30, corner_radius=8,
                          fg_color=PILL_RED, text_color=RED_DANGER, hover_color="#4B252F", font=(FONT, 11),
                          command=lambda s=key_str: self.delete_key(s)).pack(side="left", padx=2)

    # ----------------------------------------------------------- popup
    def show_new_keys(self, new_keys, perm=False):
        self.refresh()
        key_list_str = "\n".join(new_keys)
        copied = False
        if self.copy_var.get():
            self.root.clipboard_clear()
            self.root.clipboard_append(key_list_str)
            copied = True

        pop = ctk.CTkToplevel(self.root, fg_color=BG_MAIN)
        pop.title("Keys generated")
        pop.geometry("480x380")
        pop.transient(self.root)
        pop.after(150, pop.grab_set)

        n = len(new_keys)
        ctk.CTkLabel(pop, text="%d %skey%s generated" % (n, "permanent " if perm else "", "" if n == 1 else "s"),
                     font=(FONT, 16, "bold"), text_color=TEXT_WHITE).pack(pady=(20, 0))
        ctk.CTkLabel(pop, text="✓ Copied to clipboard" if copied else "Select and copy below",
                     font=(FONT, 11), text_color=GREEN_ONLINE if copied else TEXT_MUTED).pack(pady=(2, 10))
        txt = tk.Text(pop, bg=INPUT_CANVAS, fg=PERM_LAVENDER if perm else ACCENT_PURPLE, bd=0,
                      highlightbackground=BORDER_TINT, highlightthickness=1,
                      font=("Consolas", 12), padx=14, pady=14, insertbackground=TEXT_WHITE)
        txt.pack(fill="both", expand=True, padx=22, pady=5)
        txt.insert("1.0", key_list_str)
        txt.config(state="disabled")

        btns = ctk.CTkFrame(pop, fg_color="transparent")
        btns.pack(pady=16)
        ctk.CTkButton(btns, text="Copy all", width=120, height=34, corner_radius=8,
                      fg_color=ACCENT_PURPLE, hover_color=ACCENT_HOVER,
                      command=lambda: self.copy_text(key_list_str, "Copied all keys")
                      ).pack(side="left", padx=6)
        ctk.CTkButton(btns, text="Close", width=120, height=34, corner_radius=8,
                      fg_color=BORDER_TINT, hover_color="#3A365D",
                      command=pop.destroy).pack(side="left", padx=6)

    def update_action_states(self):
        state = "normal" if self.connected else "disabled"
        self.gen_btn.configure(state=state)
        self.refresh_btn.configure(state=state)
        self.connect_btn.configure(state="disabled" if self.connected else "normal")

    def close(self):
        if self.editor is not None:
            if not self.editor.can_close():
                self.show_page("Code Workspace")
                return
        self.save_config()
        self.root.destroy()


def main():
    try:
        import ctypes
        ctypes.windll.shcore.SetProcessDpiAwareness(1)
    except Exception:
        pass
    if os.name == "nt":
        try:
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("Solos.KeyManager.Desktop")
        except Exception:
            pass
    root = ctk.CTk()
    App(root)
    root.mainloop()


if __name__ == "__main__":
    main()
