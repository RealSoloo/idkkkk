    def on_perm(self):
        perm = self.perm_var.get()
        st = "disabled" if perm else "normal"
        self.hours_entry.configure(state=st)
        self.preset_seg.configure(state=st)
        self.update_summary()

    def update_summary(self):
        try:
            count = int(self.count_var.get().strip())
        except ValueError:
            count = 0
        noun = "key" if count == 1 else "keys"
        if self.perm_var.get():
            txt = "Creates %d permanent %s that never expire." % (count, noun) if count > 0 else ""
        else:
            try:
                hours = int(self.hours_var.get().strip())
            except ValueError:
                hours = 0
            if count > 0 and hours > 0:
                if hours % 24 == 0:
                    d = hours // 24
                    dur = "%d day%s" % (d, "" if d == 1 else "s")
                else:
                    dur = "%d hour%s" % (hours, "" if hours == 1 else "s")
                txt = "Creates %d %s lasting %s." % (count, noun, dur)
            else:
                txt = ""
        self.summary_lbl.configure(text=txt)

