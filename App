    def apply_app_icon(self):
        path = self.cfg.get("icon_path")
        if not path or not Path(path).is_file():
            return
        try:
            if Path(path).suffix.lower() == ".ico":
                self.root.iconbitmap(path)
                self.brand_icon.pack_forget()
            else:
                self._icon_image = tk.PhotoImage(master=self.root, file=path)
                self.root.iconphoto(True, self._icon_image)
                factor = max(1, math.ceil(max(self._icon_image.width(), self._icon_image.height()) / 40))
                self._brand_image = self._icon_image.subsample(factor, factor)
                self.brand_icon.configure(image=self._brand_image)
                self.brand_icon.pack(side="left", before=self.brand_frame, padx=(20, 0))
        except tk.TclError:
            # A missing/unsupported icon must not prevent app startup.
            pass

    def choose_app_icon(self):
        selected = filedialog.askopenfilename(parent=self.root, title="Choose your Solos icon",
                     filetypes=[("App icon", "*.png *.gif *.ico"), ("PNG image", "*.png"), ("Windows icon", "*.ico")])
        if not selected:
            return
        source = Path(selected)
        try:
            if source.suffix.lower() == ".ico":
                if os.name != "nt":
                    raise ValueError("Choose a PNG image on this operating system.")
                self.root.iconbitmap(str(source))
            else:
                # Decode before storing; the file stays local.
                tk.PhotoImage(master=self.root, file=str(source))
            target = Path(CONFIG_PATH).parent / (".solos_app_icon" + source.suffix.lower())
            fd, temporary = tempfile.mkstemp(prefix=".solos-icon-", dir=target.parent)
            try:
                with os.fdopen(fd, "wb") as stream:
                    stream.write(source.read_bytes())
                os.replace(temporary, target)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
            self.cfg["icon_path"] = str(target)
            self.save_config()
            self.apply_app_icon()
        except (OSError, ValueError, tk.TclError) as error:
            messagebox.showerror("Cannot use this icon", str(error), parent=self.root)

