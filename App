def fmt_left(hours):
    if hours <= 0:
        return "expired"
    minutes = int(round(hours * 60))
    if minutes >= 2880:
        return "%dd %dh" % (minutes // 1440, (minutes % 1440) // 60)
    return "%dh %02dm" % (minutes // 60, minutes % 60)


def time_color(hours):
    if hours <= 0:
        return RED_DANGER
    if hours < 1:
        return AMBER_PROGRESS
    return TEXT_WHITE


def key_hours(k):
    """Hours left. Worker sends 'hoursLeft' (null for permanent), older code used 'hours'."""
    for name in ("hoursLeft", "hours"):
        v = k.get(name)
        if v is not None:
            try:
                return float(v)
            except (TypeError, ValueError):
                pass
    return 0.0


def key_used(k):
    return bool(k.get("uid") or k.get("hwid"))


def key_perm(k):
    return bool(k.get("perm"))


